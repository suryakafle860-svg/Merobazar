rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return (request.auth != null && (request.auth.token.email == 'nplbzr@gmail.com' || request.auth.token.email == 'aazakobazar@gmail.com'))
        || (exists(/databases/$(database)/documents/cfg/admin)
            && get(/databases/$(database)/documents/cfg/admin).data.uid == request.auth.uid);
    }

    match /cfg/admin {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/cfg/admin)
        && request.resource.data.uid == request.auth.uid
        && (request.auth.token.email == 'nplbzr@gmail.com' || request.auth.token.email == 'aazakobazar@gmail.com');
    }

    match /pub/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.j is string && request.resource.data.j.size() < 100000;
    }

    match /priv/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.method == 'get' || request.resource.data.j.size() < 50000);
    }

    match /dir/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /logins/{lid} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && isAdmin();
    }

    match /profs/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /imgs/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && id.matches(request.auth.uid + '_.*')
        && request.resource.data.d.size() < 300000;
    }

    match /approvals/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /orders/{oid} {
      allow read: if request.auth != null && (resource.data.cuid == request.auth.uid || resource.data.muid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.cuid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.cuid == request.auth.uid || resource.data.muid == request.auth.uid || isAdmin());
      allow delete: if request.auth != null && isAdmin();
    }

    match /pays/{pid} {
      allow read: if request.auth != null && (resource.data.muid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.muid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.muid == request.auth.uid || isAdmin());
    }

    match /chats/{cid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.m;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.m
        && request.resource.data.m.size() <= 30;
      allow update: if request.auth != null && request.auth.uid in resource.data.m
        && request.resource.data.m.hasAll(resource.data.m) && request.resource.data.m.size() <= 30;

      match /msgs/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.m;
        allow create: if request.auth != null && request.resource.data.u == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.m
          && (!('a' in request.resource.data) || request.resource.data.a.size() < 400000);
      }
    }

    match /reviews/{rid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.cuid == request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.suid
        && request.resource.data.r is int && request.resource.data.r >= 1 && request.resource.data.r <= 5
        && request.resource.data.t is string && request.resource.data.t.size() <= 1000;
      allow delete: if request.auth != null && (resource.data.cuid == request.auth.uid || isAdmin());
    }
  }
}
